{
  "id": "com.brucey1777.premieregrade",
  "name": "Premiere Grade",
  "shortname": "premieregrade",
  "version": "0.1.5",
  "main": "index.html",
  "host": {
      "app": "premierepro",
      "minVersion": "25.1.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "id": "premiereGradePanel",
      "type": "panel",
      "minimumSize": {
        "width": 320,
        "height": 480
      },
      "maximumSize": {
        "width": 1024,
        "height": 2048
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 700
      },
      "label": {
        "default": "Premiere Grade"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/plugin-icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/plugin-icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
